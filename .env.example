# Publication & RPC environment mode: "local" or "fuji".
# If omitted or invalid, wallet publication is disabled while read-only scanning remains available if FUJI_RPC_URL is valid.
AVAGUARD_ENV=local

# Local Anvil mode (requires AVAGUARD_ENV=local):
FUJI_RPC_URL=http://127.0.0.1:8545

# Set from scripts/local-demo.sh or your Fuji RiskRegistry deployment to enable publication and lookup.
REGISTRY_ADDRESS=

# Fuji / hosted mode example (uncomment and replace before starting apps/web in Fuji mode; do not commit real .env.local secrets):
# AVAGUARD_ENV=fuji
# FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
# Optional strict origin lock for hosted Fuji publication (recommended in production, bare scheme + host[:port] only):
# AVAGUARD_APP_ORIGIN=https://your-avaguard-host.example.com

# Optional Gemini v2/v3 explanation adapter + Vercel serverless stateless HMAC token (server-only; never commit real keys/secrets):
# AVAGUARD_AI_ENABLED=1
# AVAGUARD_AI_PROVIDER=gemini
# Optional: "3" (default for Gemini: guarded EN/VI AI summaries) or "2" (strict selection-only)
# AVAGUARD_AI_PROMPT_VERSION=3
# GEMINI_API_KEY=
# AVAGUARD_GEMINI_MODEL=gemini-3.5-flash-lite
# Required when running across separate serverless instances (e.g. Vercel): >= 32 random chars
# AVAGUARD_EXPLAIN_SECRET=

# Optional Upstash Redis shared cache & rate limiting for Public AI (Vercel Marketplace Upstash Redis sets UPSTASH_REDIS_REST_*):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# AVAGUARD_AI_CACHE_TTL_SECONDS=86400
# AVAGUARD_AI_RATELIMIT_PER_MIN=10
# AVAGUARD_AI_RATELIMIT_GLOBAL_PER_MIN=60
