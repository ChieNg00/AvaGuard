# Publication & RPC environment mode: "local" or "fuji".
# If omitted or invalid, wallet publication is disabled while read-only scanning remains available if FUJI_RPC_URL is valid.
AVAGUARD_ENV=local

# Local Anvil mode (requires AVAGUARD_ENV=local):
FUJI_RPC_URL=http://127.0.0.1:8545

# Set from scripts/local-demo.sh or your Fuji RiskRegistry deployment to enable publication and lookup.
REGISTRY_ADDRESS=

# Fuji / hosted mode example (uncomment and replace before starting apps/web in Fuji mode; do not commit real .env.local secrets):
# AVAGUARD_ENV=fuji
# FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
# Optional strict origin lock for hosted Fuji publication (recommended in production, bare scheme + host[:port] only):
# AVAGUARD_APP_ORIGIN=https://your-avaguard-host.example.com
